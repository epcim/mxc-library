// vim: set ts=2 sw=2 et :
package infra

import "github.com/epcim/mxc/schema"

#Longhorn: S=schema.#AppCore & {
	_flavor: {
		small: {}
		[_]: {}
	}

	appName:    "longhorn"
	deployment: "kluctl"
	
	flavor: string | *"small"
	
	context: {
		csi: {
			kubeletRootDir: "/var/snap/microk8s/common/var/lib/kubelet"
		}
		preUpgradeChecker: {
			jobEnabled:          false
			upgradeVersionCheck: false
		}
	}
	tags: ["infra", "longhorn"]
	
	_flavor[S.flavor]
}
